<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f172a" />
    <title>MapTrail - Driving Mode</title>
  </head>
  <body>
    <div id="app">
      <button id="theme-toggle" type="button" aria-label="Toggle dark mode">
        Dark mode
      </button>
      <div id="map" aria-label="Map"></div>

      <div id="gps-status" aria-live="polite"></div>

      <div id="speed-limit-control">
        <label for="speed-limit-input">Speed Limit (km/h):</label>
        <input
          id="speed-limit-input"
          type="number"
          value="60"
          min="10"
          max="200"
          step="5"
          aria-label="Set speed limit"
        />
      </div>

      <div id="driving-panel">
        <div id="speedometer">
          <div id="speedometer-label">Current Speed</div>
          <div id="speedometer-value">0</div>
          <div id="speedometer-unit">km/h</div>
        </div>

        <div id="trip-computer">
          <div class="trip-stat">
            <div class="trip-stat-label">Avg Speed</div>
            <div class="trip-stat-value" id="avg-speed">0</div>
            <div class="trip-stat-suffix">km/h</div>
          </div>
          <div class="trip-stat">
            <div class="trip-stat-label">Distance</div>
            <div class="trip-stat-value" id="distance">0.00</div>
            <div class="trip-stat-suffix">km</div>
          </div>
          <div class="trip-stat">
            <div class="trip-stat-label">Time</div>
            <div class="trip-stat-value" id="trip-time">00:00:00</div>
            <div class="trip-stat-suffix">h:m:s</div>
          </div>
        </div>

        <div id="trip-controls">
          <button id="record-button" class="trip-button" type="button" aria-label="Start recording trip">
            Start Recording
          </button>
          <button id="stop-button" class="trip-button" type="button" aria-label="Stop recording trip" disabled>
            Stop Recording
          </button>
        </div>
      </div>

      <div id="history-panel">
        <div class="panel-header">
          <h2>Saved Tracks</h2>
        </div>
        <div id="track-list"></div>
      </div>

      <div id="share-panel">
        <label for="share-link">Track Link</label>
        <div class="share-row">
          <input id="share-link" type="text" readonly placeholder="No track shared yet" />
          <button id="copy-link-button" type="button">Copy Link</button>
        </div>
        <button id="share-button" type="button" class="trip-button share-button">Share</button>
      </div>
    </div>

    <script type="module" src="/src/main.js"></script>
  </body>
</html>


